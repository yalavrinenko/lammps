variable outpath string "H.ground.dat"

units real
newton on
boundary m m m
processors  1 * *
atom_style wavepacket

#START INIT SECTION
region  box block -100 100 -100 100 -100 100
create_box  2 box
create_atoms 1 single 0 0 0
create_atoms 2 random 4 222 box

mass  1 0.0544616997098749
set type 1 charge 1
set type 1 spin/wpmd 0

mass 2 0.000544616997098749
set type 2 charge -1
set type 2 spin/wpmd 1
set type 2 eradius 0.8660254037844386
set type 2 etag 42 #set unique electron tag
set type 2 cs 0.5 0.5 #set split coeff. The will normilize during the step.


group ion type 1
group eup type 2
group electrons type 2

velocity all create 20 877785 dist gaussian
#END INIT SECTION


#PAIR_STYLE
pair_style  wpmd/cut 100
pair_coeff  * *
#END_PAIR_STYLE

compute energies all pair wpmd/cut
variable eng_total equal etotal
variable etotal_ev equal v_eng_total/627.509474*27.211386


set type 2 x 0
set type 2 y 0
set type 2 z 0

thermo  1
thermo_modify norm yes
thermo_style custom step v_etotal_ev pe temp

fix ave all ave/time 1 100 10000 v_etotal_ev file ${outpath} off 1

fix mc all mc/wpmd 5 ex ew ewp

run 100000

unfix mc

